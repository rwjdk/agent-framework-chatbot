<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Blazor.LocalStorage" Version="10.0.0" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.0" />
		<PackageReference Include="Microsoft.Identity.Web" Version="4.13.2" />
		<PackageReference Include="MudBlazor" Version="9.7.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
	</ItemGroup>

</Project>
