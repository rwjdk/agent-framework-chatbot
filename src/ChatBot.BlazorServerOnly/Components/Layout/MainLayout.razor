@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" FullWidth="true" MaxWidth="MaxWidth.Large" />
<MudSnackbarProvider />

<MudIconButton Class="theme-toggle-button"
               Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
               Color="Color.Default"
               ButtonType="ButtonType.Button"
               OnClick="ToggleDarkModeAsync" />

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
