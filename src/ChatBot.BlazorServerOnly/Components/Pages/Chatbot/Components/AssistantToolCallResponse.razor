@foreach (FunctionCallContent functionCallContent in Contents.OfType<FunctionCallContent>())
{
    FunctionResultContent? functionResultContent = FindFunctionResultContent(functionCallContent.CallId);
    <article class="message-row from-assistant">
        <MudExpansionPanels Class="tool-call-panels" MultiExpansion="true" Elevation="0">
            <MudExpansionPanel Class="tool-call-entry">
                <TitleContent>
                    <div class="tool-call-title-content">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="tool-call-header">
                            <MudIcon Icon="@Icons.Material.Filled.BuildCircle" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="tool-call-title">Tool Call</MudText>
                            <MudText Typo="Typo.caption" Class="tool-call-summary">@functionCallContent.AsDisplayString()</MudText>
                        </MudStack>
                        @if (functionResultContent is null)
                        {
                            <MudProgressLinear Class="tool-call-progress" Indeterminate="true" Color="Color.Primary" />
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (ShouldShowFullFunctionCall(functionCallContent))
                    {
                        <div class="tool-call-full-request">
                            <p class="tool-call-full-request-title">Full Request</p>
                            <p class="tool-call-full-text">@functionCallContent.AsDisplayString()</p>
                        </div>
                    }

                    @if (functionResultContent is not null)
                    {
                        <pre class="meta-info tool-call-result"><code>@functionResultContent.AsDisplayString()</code></pre>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </article>
}

@code {
    private const int CollapsedFunctionCallLength = 96;

    [Parameter, EditorRequired]
    public IEnumerable<AIContent> Contents { get; set; }

    [Parameter]
    public Conversation? Conversation { get; set; }

    private FunctionResultContent? FindFunctionResultContent(string callId)
    {
        IEnumerable<AIContent> contents = Conversation == null ? Contents : Conversation.Messages.SelectMany(x => x.Contents);

        return contents.OfType<FunctionResultContent>().FirstOrDefault(x => x.CallId == callId);
    }

    private static bool ShouldShowFullFunctionCall(FunctionCallContent functionCallContent)
    {
        return functionCallContent.AsDisplayString().Length > CollapsedFunctionCallLength;
    }
}
