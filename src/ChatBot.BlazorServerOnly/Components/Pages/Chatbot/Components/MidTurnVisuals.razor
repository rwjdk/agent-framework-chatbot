@using ChatBot.BlazorServerOnly.Models
@using ServiceDefaults.Models
@if (Settings.Streaming)
{
    if (IsWaitingForAssistant && !HasStreamedVisuals)
    {
        <AssistantProgress />
    }

    if (Settings.ShowReasoning && State.StreamedReasoning != null)
    {
        <article class="message-row from-assistant">
            <div class="meta-info markdown-content">@RenderedStreamedReasoning</div>
        </article>
    }

    if (Settings.ShowToolCalls)
    {
        <AssistantToolCallResponse Contents="State.StreamedContents"/>
    }
    
    if (!string.IsNullOrEmpty(State.StreamedResponse))
    {
        <article class="message-row from-assistant">
            <div class="message-bubble">
                <p class="message-text">@State.StreamedResponse</p>
            </div>
        </article>
    }
}
else
{
    //Non-streaming
    if (IsWaitingForAssistant)
    {
        <AssistantProgress />
    }
}

@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    [Parameter, EditorRequired]
    public Settings Settings { get; set; }

    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; }

    [Parameter, EditorRequired]
    public State State { get; set; }

    private MarkupString RenderedStreamedReasoning => new(Markdown.ToHtml(State.StreamedReasoning ?? string.Empty, MarkdownPipeline));

    private bool IsWaitingForAssistant => Conversation.Messages.LastOrDefault()?.Role == ChatRole.User;

    private bool HasStreamedVisuals => !string.IsNullOrWhiteSpace(State.StreamedReasoning)
                                      || !string.IsNullOrWhiteSpace(State.StreamedResponse)
                                      || State.StreamedContents.Any();
}
