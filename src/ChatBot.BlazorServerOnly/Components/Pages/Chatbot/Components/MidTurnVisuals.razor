@using ChatBot.BlazorServerOnly.Models
@using ServiceDefaults.Models
@if (UseStreaming)
{
    if (IsWaitingForAssistant && !HasStreamedVisuals)
    {
        <AssistantProgress />
    }

    if (ShowReasoning && VisualState.StreamedReasoning != null)
    {
        <article class="message-row from-assistant">
            <div class="meta-info markdown-content">@RenderedStreamedReasoning</div>
        </article>
    }

    if (ShowToolCalls)
    {
        <AssistantToolCallResponse Contents="VisualState.StreamedContents"/>
    }
    
    if (!string.IsNullOrEmpty(VisualState.StreamedResponse))
    {
        <article class="message-row from-assistant">
            <div class="message-bubble">
                <p class="message-text">@VisualState.StreamedResponse</p>
            </div>
        </article>
    }
}
else
{
    //Non-streaming
    if (IsWaitingForAssistant)
    {
        <AssistantProgress />
    }
}

@code {
    [Inject]
    private MarkdownPipeline MarkdownPipeline { get; set; } = default!;

    [Inject]
    private ServerSettings ServerSettings { get; set; } = default!;

    [Parameter, EditorRequired]
    public Settings Settings { get; set; }

    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; }

    [Parameter, EditorRequired]
    public VisualState VisualState { get; set; }

    private MarkupString RenderedStreamedReasoning => new(Markdown.ToHtml(VisualState.StreamedReasoning ?? string.Empty, MarkdownPipeline));

    private bool IsWaitingForAssistant => Conversation.Messages.LastOrDefault()?.Role == ChatRole.User;

    private bool UseStreaming => !ServerSettings.AllowChatVisualsCustomization || Settings.Streaming;

    private bool ShowReasoning => ServerSettings.AllowChatVisualsCustomization && Settings.ShowReasoning;

    private bool ShowToolCalls => ServerSettings.AllowChatVisualsCustomization && Settings.ShowToolCalls;

    private bool HasStreamedVisuals => (ShowReasoning && !string.IsNullOrWhiteSpace(VisualState.StreamedReasoning))
                                      || !string.IsNullOrWhiteSpace(VisualState.StreamedResponse)
                                      || (ShowToolCalls && VisualState.StreamedContents.Any());
}
