@if (InImageGenerationMode)
{
    <article class="message-row from-assistant">
        <p class="meta-info">Generating Image. Please wait...</p>
    </article>
}

@if (Streaming)
{
    if (IsWaitingForAssistant && !HasStreamedVisuals)
    {
        <AssistantProgress />
    }

    if (StreamedReasoning != null)
    {
        <article class="message-row from-assistant">
            <div class="meta-info markdown-content">@RenderedStreamedReasoning</div>
        </article>
    }

    <AssistantToolCallResponse Contents="StreamedContents" />

    if (!string.IsNullOrEmpty(StreamedResponse))
    {
        <article class="message-row from-assistant">
            <div class="message-bubble">
                <p class="message-text">@StreamedResponse</p>
            </div>
        </article>
    }
}
else
{
    //Non-streaming
    if (IsWaitingForAssistant)
    {
        <AssistantProgress />
    }
}

@code {
    private static readonly Markdig.MarkdownPipeline MarkdownPipeline = new Markdig.MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    [Parameter, EditorRequired]
    public bool Streaming { get; set; }

    [Parameter, EditorRequired]
    public bool InImageGenerationMode { get; set; }

    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<AIContent> StreamedContents { get; set; }
    
    [Parameter, EditorRequired]
    public string? StreamedReasoning { get; set; }
    
    [Parameter, EditorRequired]
    public string? StreamedResponse { get; set; }

    private MarkupString RenderedStreamedReasoning => new(Markdig.Markdown.ToHtml(StreamedReasoning ?? string.Empty, MarkdownPipeline));

    private bool IsWaitingForAssistant => Conversation.Messages.LastOrDefault()?.Role == ChatRole.User;

    private bool HasStreamedVisuals => !string.IsNullOrWhiteSpace(StreamedReasoning)
                                      || !string.IsNullOrWhiteSpace(StreamedResponse)
                                      || StreamedContents.Any();
}
