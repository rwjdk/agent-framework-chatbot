@foreach (AIContent content in Contents)
{
    if (content is TextReasoningContent textReasoningContent && !string.IsNullOrWhiteSpace(textReasoningContent.Text))
    {
        <article class="message-row from-assistant">
            <div class="meta-info markdown-content">@RenderMarkdown(textReasoningContent.Text)</div>
        </article>
    }
}
@code 
{
    [Inject]
    private MarkdownPipeline MarkdownPipeline { get; set; } = default!;

    [Parameter, EditorRequired]
    public IEnumerable<AIContent> Contents { get; set; }

    private MarkupString RenderMarkdown(string text)
    {
        return new(Markdown.ToHtml(text, MarkdownPipeline));
    }
}
