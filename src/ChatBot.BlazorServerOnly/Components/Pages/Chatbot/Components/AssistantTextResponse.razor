@using ServiceDefaults.Models
@if (!string.IsNullOrWhiteSpace(Message.Text))
{
    <article class="message-row from-assistant">
        <div class="message-bubble">
            <div class="message-text markdown-content">@RenderedMarkdown</div>

            @if (Settings.ShowTokens && Message.Usage != null)
            {
                <div class="token-usage" aria-label="Token usage">
                    <span>@Message.Usage.InputTokenCount in</span>
                    <span>@Message.Usage.OutputTokenCount out</span>
                    @if (Message.Usage.ReasoningTokenCount > 0)
                    {
                        <span>@Message.Usage.ReasoningTokenCount reasoning</span>
                    }
                </div>
            }
        </div>
    </article>
}
@code
{
    [Inject]
    private MarkdownPipeline MarkdownPipeline { get; set; } = default!;

    [Parameter, EditorRequired]
    public Settings Settings { get; set; }
    
    [Parameter, EditorRequired]
    public ConversationMessage Message { get; set; }

    private MarkupString RenderedMarkdown => new(Markdown.ToHtml(Message.Text, MarkdownPipeline));
}
